# ==========================================
# Neighborhood Safety Network - Environment
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME="Neighborhood Safety Network"

# PostgreSQL + PostGIS Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neighborhood_safety
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neighborhood_safety

# JWT Authentication
JWT_SECRET=supersecret_jwt_dev_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=15m

# SMTP Email Configuration (Free / Open-Source / Local SMTP compatible)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Neighborhood Safety Network <noreply@neighborhoodsafety.org>"

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_PROVIDER=mock # Options: 'smtp' or 'mock'
SMS_OTP_PROVIDER=mock   # Options: 'mock' (Extensible for real SMS gateway)

# Module 2: Location & Safety Perimeter Configuration
DEFAULT_SAFETY_RADIUS_METERS=2000
MAX_SAFETY_RADIUS_METERS=50000
